{
  "check_interval_seconds": 60,
  "cleanup_interval_seconds": 150,
  "docker_disk_usage_threshold_gb": 700,
  "docker_disk_usage_warning_gb": 600,
  "cleanup_stopped_containers": true,
  "container_age_threshold_minutes": 1,
  "cleanup_unused_images": true,
  "image_age_threshold_minutes": 1,
  "keep_latest_images": 0,
  "dry_run": false,
  "max_containers_per_cleanup": 50,
  "max_images_per_cleanup": 25,
  "log_file": "docker_disk_space_manager.log",
  "prune_dangling_images": true,
  "prune_builder_cache": true
}
